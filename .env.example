# Firebase Admin service account (choose this format...)
FIREBASE_PROJECT_ID=co-worker-d8642
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@co-worker-d8642.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

